local function Auto_XP_Farm()
    task.spawn(function()
        while FarmXP do
            local rStorage = game:GetService("ReplicatedStorage")
            local rEvents = rStorage:FindFirstChild("rEvents")
            if rEvents and rEvents:FindFirstChild("orbEvent") then
                rEvents.orbEvent:FireServer("collectOrb", "Yellow Orb", "City")
            end
