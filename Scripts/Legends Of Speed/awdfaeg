-- Holt sich das globale GUI-Objekt aus unserem Hauptskript
local GUI = _G.GUI or shared.GUI
if not GUI then return end

-- ── EIGENER NAVIGATION-BEREICH IM SKRIPT ─────────────────────────────────────
-- Das hier erstellt die neue Kategorie im linken Seitenmenü deines Hubs
GUI:NavSection("Legends Of Speed")

-- Hier erstellen wir den dazugehörigen Reiter (Tab)
local MainSec = GUI:CreateTab({ name = "Farming", icon = "" })
MainSec:Section({ name = "Main Farm" })

-- Variablen für die Schleifen
local FarmOrbs = false
local FarmGems = false
local FarmXP = false
local FarmJumps = false
local AutoRebirth = false

-- ── DEFINITION DER FUNKTIONEN ───
local function Auto_Orb_Farm()
    task.spawn(function()
        while FarmOrbs do
            local rStorage = game:GetService("ReplicatedStorage")
            local rEvents = rStorage:FindFirstChild("rEvents")
            if rEvents and rEvents:FindFirstChild("orbEvent") then
                rEvents.orbEvent:FireServer("collectOrb", "Orange Orb", "City")
            end
            task.wait(0.1)
        end
    end)
end

